{
  "id": "lipid_lowering",
  "title_tr": "Lipid Düşürücüler — Kolesterol Metabolizması",
  "description_tr": "HMG-CoA redüktaz (statin), NPC1L1 (ezetimib), PPAR-α (fibrat), PCSK9 yolakları. LDL düşürme, HDL artırma, miyopati ve hepatotoksisite profilleri.",
  "source_attribution": "Lipid farmakolojisi StatPearls (Statins, Ezetimibe, Fibrates, PCSK9 inhibitors) ve GtoPdb (CC BY-SA 4.0) temel alınarak derlenmiştir.",
  "nodes": [
    {
      "id": "med_ldl",
      "label_tr": "LDL-kolesterol",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "Aterojenik lipoprotein. LDL reseptörü aracılı hepatosit uptake ile plazma düzeyi düzenlenir. Hedef: ASCVD risk azaltımı."
    },
    {
      "id": "med_hdl",
      "label_tr": "HDL-kolesterol",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "Reverse kolesterol transport. Düşük HDL kardiyovasküler risk faktörü. Niasin ve fibratlar artırabilir."
    },
    {
      "id": "med_tg",
      "label_tr": "Trigliserid (TG)",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "VLDL/kilomikron bileşeni. Yüksek TG pankreatit riski (aşırı yüksek). Fibratlar ve omega-3 en etkili."
    },
    {
      "id": "med_bile_acid",
      "label_tr": "Safra asitleri",
      "type": "mediator",
      "high_yield": false,
      "description_tr": "Kolesterol yıkım ürünü. Resinler (kolestiramin) safra asitlerini bağlayarak hepatik kolesterol tüketimini artırır."
    },
    {
      "id": "r_ldl_receptor",
      "label_tr": "LDL reseptörü",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Hepatosit yüzeyinde LDL uptake. Statinler intraselüler kolesterol ↓ → reseptör upregülasyonu → plazma LDL ↓."
    },
    {
      "id": "r_npc1l1",
      "label_tr": "NPC1L1 (intestinal)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "İnce bağırsakta kolesterol emilim taşıyıcısı. Ezetimib hedefi."
    },
    {
      "id": "r_ppar_alpha",
      "label_tr": "PPAR-α",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Nükleer reseptör. Lipoprotein lipaz ekspresyonu ↑ → VLDL/TG klirensi. Fenofibrat/gemfibrozil hedefi."
    },
    {
      "id": "r_pcsk9",
      "label_tr": "PCSK9",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "LDL reseptör degradasyonunu artıran protein. İnhibitörler (evolocumab) LDL reseptör ömrünü uzatır."
    },
    {
      "id": "o_hmgcoa",
      "label_tr": "HMG-CoA redüktaz",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Kolesterol sentezinin hız kısıtlayıcı enzimi (karaciğer). Statinlerin doğrudan hedefi. Gece sentezi aktif → akşam dozu önerisi."
    },
    {
      "id": "o_hepatocyte",
      "label_tr": "Hepatosit",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Kolesterol sentezi, LDL reseptör ekspresyonu ve VLDL salınımı. Statin hepatotoksisitesi burada izlenir (ALT)."
    },
    {
      "id": "o_intestine",
      "label_tr": "İnce bağırsak",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Diyet ve safra kolesterol emilimi. Ezetimib ve bile asit sequestrantları burada/enterohepatik dolaşımda etkili."
    },
    {
      "id": "o_muscle",
      "label_tr": "İskelet kası",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Statinler kas hücrelerinde CoQ10/ mitokondriyal etki ile miyopati/rabdomiyoliz yapabilir (nadir, doz ve ilaç etkileşimi)."
    },
    {
      "id": "o_vascular",
      "label_tr": "Vasküler endotel / plak",
      "type": "organ",
      "high_yield": true,
      "description_tr": "LDL ↓ ile aterosklerotik plak stabilizasyonu ve ACS risk azalması (statin kanıtı en güçlü)."
    },
    {
      "id": "e_ldl_down",
      "label_tr": "LDL ↓ & ASCVD risk ↓",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Statinler birinci basamak. Her 1 mmol/L LDL ↓ ile majör vasküler olay riski ~%20 azalır."
    },
    {
      "id": "e_tg_down",
      "label_tr": "Trigliserid ↓",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Fibratlar, omega-3 (yüksek doz), niasin. Aşırı hipertrigliseridemide pankreatit önleme."
    },
    {
      "id": "e_hdl_up",
      "label_tr": "HDL ↑",
      "type": "effect",
      "high_yield": false,
      "description_tr": "Fibrat ve niasin HDL artırır; HDL hedefleyen tedavinin CV faydası statin kadar kanıtlı değil."
    },
    {
      "id": "e_myopathy",
      "label_tr": "Miyopati / rabdomiyoliz",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Statin (+ gemfibrozil/CYP3A4 etkileşimi) ile kas ağrısı, CK ↑. Rabdomiyoliz nadirdir ama ciddi."
    },
    {
      "id": "e_hepatotox",
      "label_tr": "Hepatotoksisite (ALT ↑)",
      "type": "effect",
      "high_yield": false,
      "description_tr": "Statinlerde genelde hafif, asymptomatik transaminaz ↑. Ciddi hepatit nadirdir."
    },
    {
      "id": "e_gallstones",
      "label_tr": "Safra taşı riski",
      "type": "effect",
      "high_yield": false,
      "description_tr": "Fibratlar safra kolesterol saturasyonunu artırarak taş riskini yükseltebilir."
    }
  ],
