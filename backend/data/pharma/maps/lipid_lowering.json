  "quiz": [
    {
      "q_tr": "Statinlerin LDL düşürücü etkisinin temel mekanizması nedir?",
      "options_tr": [
        "Safra asit emilimini bloke etmek",
        "HMG-CoA redüktaz inhibisyonu → LDL reseptör upregülasyonu",
        "PCSK9 aktivasyonu",
        "PPAR-α agonizması"
      ],
      "answer_idx": 1,
      "explanation_tr": "Statinler hepatik kolesterol sentezini inhibe eder → hücre LDL reseptörlerini artırır → plazma LDL klirensi ↑.",
      "node_id": "o_hmgcoa"
    },
    {
      "q_tr": "Ezetimib hangi basamakta etki eder?",
      "options_tr": [
        "HMG-CoA redüktaz",
        "NPC1L1 ile intestinal kolesterol emilimi",
        "Lipoprotein lipaz",
        "Kolesterol ester transfer proteini"
      ],
      "answer_idx": 1,
      "explanation_tr": "Ezetimib ince bağırsak NPC1L1 taşıyıcısını inhibe eder; statin ile kombine LDL düşüşü sinerjiktir.",
      "node_id": "r_npc1l1"
    },
    {
      "q_tr": "Statin + gemfibrozil kombinasyonunda en ciddi risk nedir?",
