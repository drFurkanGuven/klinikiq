  "quiz": [
    {
      "q_tr": "Metforminin birincil antihiperglisemik mekanizması nedir?",
      "options_tr": [
        "Pankreastan insülin salınımını artırmak",
        "Hepatik glukoneogenezi azaltmak",
        "SGLT2'yi inhibe etmek",
        "DPP-4'ü inhibe etmek"
      ],
      "answer_idx": 1,
      "explanation_tr": "Metformin esas olarak karaciğerde AMPK aktivasyonu ile glukoneogenezi baskılar. İnsülin salınımını doğrudan artırmaz → monoterapide hipoglisemi riski düşük.",
      "node_id": "o_liver"
    },
    {
      "q_tr": "Sulfonilürelerin hipoglisemi yapmasının mekanizması nedir?",
      "options_tr": [
        "GLP-1 reseptör agonizması",
        "β hücre KATP kanalını kapatmak",
        "SGLT2 inhibisyonu",
        "Glukagon salınımını artırmak"
      ],
      "answer_idx": 1,
      "explanation_tr": "Sulfonilüreler KATP kanalını bloke ederek insülin salınımını glukozdan bağımsız artırır → hipoglisemi riski.",
      "node_id": "r_katp"
    },
    {
      "q_tr": "SGLT2 inhibitörleri glukozu nasıl düşürür?",
      "options_tr": [
        "İnsülin salınımını artırarak",
        "Böbrekte glukoz geri emilimini azaltarak",
        "Karaciğer glukoneogenezini artırarak",
        "Kas GLUT4'ü bloke ederek"
      ],
      "answer_idx": 1,
      "explanation_tr": "Empagliflozin vb. proksimal tübül SGLT2'yi inhibe eder → glukozüri → kan glukozu ↓. İnsülin salınımına bağlı değildir.",
      "node_id": "r_sglt2"
    },
    {
      "q_tr": "Tip 1 diyabetli bir hastada mutlak insülin eksikliği hangi acil komplikasyona yol açar?",
      "options_tr": [
        "Hipoglisemi",
        "Diabetik ketoasidoz",
        "Hiperosmolar hiperglisemi",
        "Laktik asidoz"
      ],
      "answer_idx": 1,
      "explanation_tr": "Tip 1 DM'de insülin yokluğu → lipoliz + ketogenez → DKA. Hiperosmolar durum daha çok tip 2'de görülür.",
      "node_id": "e_dka"
    },
    {
      "q_tr": "GLP-1 reseptör agonistleri insülin salınımını nasıl artırır?",
      "options_tr": [
        "Glukozdan bağımsız sürekli salınım",
        "Glukoz-bağımlı, artmış insülin salınımı",
        "Sadece glukagon artırarak",
        "SGLT2 inhibisyonu ile"
      ],
      "answer_idx": 1,
      "explanation_tr": "GLP-1 RA glukoz yükseldiğinde insülin salınımını güçlendirir; açlıkta aşırı insülin riski sulfonilüreye göre daha düşüktür.",
      "node_id": "r_glp1r"
    },
    {
      "q_tr": "Metformin hangi durumda kontrendike / dikkatli kullanılmalıdır?",
      "options_tr": [
        "Hafif hipertansiyon",
        "eGFR <30 mL/dk / ciddi hipoksi",
        "Hiperlipidemi",
        "Obezite"
      ],
      "answer_idx": 1,
      "explanation_tr": "Böbrek yetmezliği, kontrast sonrası, sepsis/hipoksi gibi laktat birikimini artıran durumlarda metformin kesilir veya doz azaltılır.",
      "node_id": "e_lactic_acidosis"
    }
  ],
