{
  "id": "insulin_diabetes",
  "title_tr": "İnsülin & Antidiyabetik İlaçlar",
  "description_tr": "Glukoz homeostazı: pankreas β hücresi, karaciğer, kas ve böbrek hedefleri. İnsülin, metformin, sulfonilüre, GLP-1 RA, DPP-4 inhibitörü, SGLT2 inhibitörü ve TZD mekanizmaları.",
  "source_attribution": "Diyabet farmakolojisi StatPearls (Diabetes Pharmacology, Metformin, SGLT2 inhibitors, GLP-1 agonists) ve GtoPdb (CC BY-SA 4.0) temel alınarak derlenmiştir.",
  "nodes": [
    {
      "id": "med_glucose",
      "label_tr": "Glukoz",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "Ana enerji substratı. Postprandial yükseliş insülin salınımını uyarır; açlıkta glukagon ve glukoneogenez devreye girer."
    },
    {
      "id": "med_insulin",
      "label_tr": "İnsülin",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "Pankreas β hücresinden salınan anabolik hormon. Kas ve yağda glukoz uptake, karaciğerde glukoneogenez/glikojenoliz inhibisyonu."
    },
    {
      "id": "med_glucagon",
      "label_tr": "Glukagon",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "α hücresi ürünü. Karaciğerde glikojenoliz ve glukoneogenez artırır → kan glukozu ↑. İnsülinle zıt etki."
    },
    {
      "id": "med_glp1",
      "label_tr": "GLP-1 (incretin)",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "L hücrelerinden postprandial salınır. Glukoz-bağımlı insülin salınımı, glukagon baskılama, mide emptying yavaşlatma, tokluk."
    },
    {
      "id": "r_insulin_receptor",
      "label_tr": "İnsülin reseptörü (tirozin kinaz)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "α2β2 heterotetramer. İnsülin bağlanınca otofosforilasyon → IRS/PI3K/Akt yolu → GLUT4 translokasyonu (kas/yağ)."
    },
    {
      "id": "r_glp1r",
      "label_tr": "GLP-1 reseptörü",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Gs bağlı reseptör. β hücrede cAMP ↑ → insülin salınımı (glukoz-bağımlı). GLP-1 RA ve DPP-4 inhibitörü yolu."
    },
    {
      "id": "r_katp",
      "label_tr": "KATP kanalı (β hücre)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Glukoz metabolizması ATP artırınca kapanır → membran depolarizasyonu → Ca²⁺ girişi → insülin salınımı. Sulfonilüreler burayı bloke eder."
    },
    {
      "id": "r_sglt2",
      "label_tr": "SGLT2 (böbrek)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Proksimal tübülde glukoz geri emilim taşıyıcısı. İnhibitörler glukozüri yaparak kan glukozunu düşürür."
    },
    {
      "id": "r_ppar_gamma",
      "label_tr": "PPAR-γ",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Nükleer reseptör. Adiposit diferansiyasyonu ve insülin duyarlılığı. Pioglitazon/roziglitazon hedefi (TZD)."
    },
    {
      "id": "r_dpp4",
      "label_tr": "DPP-4 enzimi",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "GLP-1 ve GIP'i yıkar. DPP-4 inhibitörleri (sitagliptin) incretin düzeyini artırır."
    },
    {
      "id": "o_beta_cell",
      "label_tr": "Pankreas β hücresi",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Glukoz/KATP/Ca²⁺ yolu ile insülin salınımı. Tip 1 DM'de otoimmün yıkım; tip 2'de rezistans + relatif yetmezlik."
    },
    {
      "id": "o_liver",
      "label_tr": "Karaciğer",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Glukoneogenez ve glikojenoliz/glukojen sentez dengesi. Metformin'in birincil hedefi (AMPK aktivasyonu)."
    },
    {
      "id": "o_muscle",
      "label_tr": "İskelet kası",
      "type": "organ",
      "high_yield": true,
      "description_tr": "GLUT4 aracılı glukoz uptake. İnsülin duyarlılığı tip 2 DM patogenezinde merkezi."
    },
    {
      "id": "o_kidney_tubule",
      "label_tr": "Böbrek proksimal tübül",
      "type": "organ",
      "high_yield": true,
      "description_tr": "SGLT2 ile filtrat glukozunun ~90%'i geri emilir. SGLT2i burada etki eder."
    },
    {
      "id": "o_adipose",
      "label_tr": "Adipoz doku",
      "type": "organ",
      "high_yield": false,
      "description_tr": "PPAR-γ aktivasyonu ile insülin duyarlılığı artar; sıvı retansiyonu ve kilo artışı yan etki."
    },
    {
      "id": "e_hypoglycemia",
      "label_tr": "Hipoglisemi",
      "type": "effect",
      "high_yield": true,
      "description_tr": "İnsülin/sulfonilüre/GLP-1 RA (nadiren) ile kan glukozu <70 mg/dL. Terleme, taşikardi, bilinç değişikliği; şeker/glukagon antidot."
    },
    {
      "id": "e_hyperglycemia",
      "label_tr": "Hiperglisemi / HbA1c ↑",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Yetersiz insülin veya insülin direnci. Kronik mikrovasküler (retinopati, nefropati) ve makrovasküler komplikasyonlar."
    },
    {
      "id": "e_dka",
      "label_tr": "DKA riski",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Mutlak insülin eksikliğinde (tip 1) keton cisimcikleri, asidoz. SGLT2i ile euglycemic DKA nadiren görülür."
    },
    {
      "id": "e_weight_loss",
      "label_tr": "Kilo kaybı",
      "type": "effect",
      "high_yield": false,
      "description_tr": "Metformin, GLP-1 RA ve SGLT2i ile görülebilir. Sulfonilüre ve insülin kilo artırabilir."
    },
    {
      "id": "e_gi_nausea",
      "label_tr": "Bulantı / GI yan etki",
      "type": "effect",
      "high_yield": false,
      "description_tr": "Metformin (başlangıç) ve GLP-1 RA'da sık. Metformin B12 malabsorpsiyonu uzun dönemde."
    },
    {
      "id": "e_cv_benefit",
      "label_tr": "Kardiyovasküler koruma",
      "type": "effect",
      "high_yield": true,
      "description_tr": "SGLT2i (empagliflozin, dapagliflozin) ve bazı GLP-1 RA (liraglutid, semaglutid) CV mortalite/MACE azaltımı kanıtı."
    },
    {
      "id": "e_lactic_acidosis",
      "label_tr": "Laktik asidoz (metformin)",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Böbrek yetmezliği, kontrast, ciddi hipoksi/perioperatif dönemde metformin birikimi → nadiren laktik asidoz."
    }
  ],
