{
  "id": "coagulation",
  "title_tr": "Koagülasyon & Antikoagülantlar",
  "description_tr": "Extrinsic, intrinsic ve ortak yolak üzerinden trombin → fibrin kaskadı. Heparin, warfarin, DOAC, antiplatelet ve fibrinolitik ajanların hedef basamakları ve kanama riski profili.",
  "source_attribution": "Koagülasyon kaskadı ve antikoagülant farmakolojisi StatPearls (Hemostasis, Warfarin, DOAC, Heparin) ve IUPHAR/BPS GtoPdb (CC BY-SA 4.0) temel alınarak derlenmiştir.",
  "nodes": [
    { "id": "med_tf", "label_tr": "Doku faktörü (TF)", "type": "mediator", "high_yield": true, "description_tr": "Vasküler yaralanmada eksprese olan transmembran protein. Faktör VIIa ile kompleks oluşturarak extrinsic yolu başlatır." },
    { "id": "med_fibrinogen", "label_tr": "Fibrinojen", "type": "mediator", "high_yield": true, "description_tr": "Trombin tarafından fibrin monomerlerine kesilir; faktör XIIIa ile çapraz bağlanarak stabil pıhtı oluşturur." },
    { "id": "med_fibrin", "label_tr": "Fibrin pıhtısı", "type": "mediator", "high_yield": true, "description_tr": "Koagülasyonun son ürünü. tPA/streptokinaz ile plazminojen → plazmin yoluyla lizis edilir." },
    { "id": "med_thrombin", "label_tr": "Trombin (F IIa)", "type": "mediator", "high_yield": true, "description_tr": "Protrombin (F II) aktivasyonu ile oluşur. Fibrinojeni keser, F V/VIII/XI/XIII'ü aktive eder, trombosit agregasyonunu güçlendirir, antikoagülant protein C yolunu da uyarır." },
    { "id": "med_plasmin", "label_tr": "Plazmin", "type": "mediator", "high_yield": true, "description_tr": "Plazminojen aktivasyonu ile oluşan fibrinolitik enzim. Fibrin pıhtısını parçalar." },

    { "id": "r_p2y12", "label_tr": "Trombosit P2Y12", "type": "receptor", "high_yield": true, "description_tr": "ADP reseptörü. Aktivasyon trombosit agregasyonunu sürdürür. Klopidogrel/tikagrelor hedefidir." },
    { "id": "r_gp2b3a", "label_tr": "GP IIb/IIIa", "type": "receptor", "high_yield": false, "description_tr": "Fibrinojen bağlanma reseptörü; trombosit agregasyonunun son ortak basamağı. Abciximab/tirofiban hedefidir." },
    { "id": "r_atiii", "label_tr": "Antitrombin III", "type": "receptor", "high_yield": true, "description_tr": "Serin proteaz inhibitörü. Heparin ATIII aktivitesini ~1000 kat artırarak IIa ve Xa'yı inhibe eder." },

    { "id": "o_extrinsic", "label_tr": "Extrinsic yol (TF–VIIa)", "type": "organ", "high_yield": true, "description_tr": "Doku faktörü + F VIIa → F X aktivasyonu. PT/INR ile izlenen yolak; warfarin ve FXa inhibitörlerinin hedef basamağı." },
    { "id": "o_intrinsic", "label_tr": "Intrinsic yol (XII–XI–IX–VIII)", "type": "organ", "high_yield": true, "description_tr": "Kontakt aktivasyonu ile başlar. Hemofili A (VIII eksik) ve B (IX eksik) bu yolda. aPTT ile izlenir." },
    { "id": "o_common", "label_tr": "Ortak yol (X–V → protrombin)", "type": "organ", "high_yield": true, "description_tr": "F Xa + F Va → protrombinaz kompleksi → trombin. DOAC'ların (dabigatran, rivaroxaban) ana hedefleri burada." },
    { "id": "o_liver_vitk", "label_tr": "Karaciğer (K vitamini bağımlı faktörler)", "type": "organ", "high_yield": true, "description_tr": "II, VII, IX, X ve protein C/S sentezi K vitamini (epoksit redüktaz) gerektirir. Warfarin bu sentezi bloke eder." },
    { "id": "o_platelet", "label_tr": "Trombosit", "type": "organ", "high_yield": true, "description_tr": "COX-1 → TXA2, ADP/P2Y12 ve GP IIb/IIIa ile agregasyon. Antiplatelet ajanların hedefi." },
    { "id": "o_cox1", "label_tr": "COX-1 (trombosit)", "type": "organ", "high_yield": true, "description_tr": "Aspirinin hedefi. Tromboksan A2 sentezini kalıcı inhibe eder → trombosit agregasyonu ↓." },

    { "id": "e_clot", "label_tr": "Pıhtı oluşumu", "type": "effect", "high_yield": true, "description_tr": "Fibrin ağı + trombosit plug. Hemostaz ve tromboembolizm patofizyolojisi." },
    { "id": "e_bleeding", "label_tr": "Kanama riski", "type": "effect", "high_yield": true, "description_tr": "Antikoagülant/antiplatelet/fibrinolitik tedavinin ana advers etkisi. INR/aPTT/anti-Xa ile izlem." },
    { "id": "e_thrombosis_prevent", "label_tr": "Tromboz önleme", "type": "effect", "high_yield": true, "description_tr": "AF, DVT/PE, mekanik kapak ve koroner arter hastalığında antitrombotik endikasyon." },
    { "id": "e_fibrinolysis", "label_tr": "Fibrinoliz (pıhtı eritme)", "type": "effect", "high_yield": true, "description_tr": "tPA/streptokinaz ile plazminojen aktivasyonu. Akut MI, iskemik inme (uygun seçilmiş), masif PE." },
    { "id": "e_heparin_induced", "label_tr": "HIT (heparin ilişkili trombositopeni)", "type": "effect", "high_yield": true, "description_tr": "UFH/LMWH'ye bağlı antikor aracılı trombosit aktivasyonu → paradoks tromboz + trombositopeni. Warfarin tek başına kontrendike." },
    { "id": "e_warfarin_skin", "label_tr": "Warfarin deri nekrozu", "type": "effect", "high_yield": false, "description_tr": "Protein C eksikliğinde veya yüksek doz warfarin başlangıcında nadiren. Protektif heparin ile başlangıç önerilir." }
  ],
