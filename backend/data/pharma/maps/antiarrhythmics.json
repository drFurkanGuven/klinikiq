  "quiz": [
    {
      "q_tr": "Flekainid (sınıf IC) EKG'de en belirgin hangi değişikliği yapar?",
      "options_tr": [
        "QT kısalması",
        "QRS genişlemesi",
        "PR kısalması",
        "U dalgası kaybı"
      ],
      "answer_idx": 1,
      "explanation_tr": "Sınıf IC ajanlar güçlü Na⁺ kanal bloğu yapar → ventriküler depolarizasyon yavaşlar → QRS genişler.",
      "node_id": "e_qrs_wide"
    },
    {
      "q_tr": "AV nodal reentrant taşikardi (AVNRT) acil tedavisinde hangi sınıf tercih edilir?",
      "options_tr": [
        "Sınıf IB (lidokain)",
        "Sınıf IV (verapamil) veya adenozin",
        "Sınıf IC (flekainid)",
        "Digoksin tek başına"
      ],
      "answer_idx": 1,
      "explanation_tr": "AV nodal iletiyi yavaşlatan sınıf IV veya adenozin reentrant devreyi keser. Adenozin yarı ömrü çok kısadır.",
      "node_id": "r_cav12"
    },
    {
      "q_tr": "Sotalol hangi iki Vaughan Williams sınıfının özelliklerini taşır?",
      "options_tr": [
        "I ve II",
        "II ve III",
        "III ve IV",
        "I ve IV"
      ],
      "answer_idx": 1,
      "explanation_tr": "Sotalol racemik: D-isomeri β-bloker (II), L-isomeri K⁺ kanal bloker (III). QT uzaması riski taşır.",
      "node_id": "r_herg"
    },
    {
      "q_tr": "Digoksin toksisitesi hangi elektrolit bozukluğunda belirginleşir?",
      "options_tr": [
        "Hiperkalemi",
        "Hipokalemi",
        "Hipernatremi",
        "Hipomagnezemi olmadan hiç etkilenmez"
      ],
      "answer_idx": 1,
      "explanation_tr": "Hipokalemi Na⁺/K⁺-ATPaz inhibisyonunu güçlendirir → digoksin toksisitesi (aritmi, bulantı, görme haleleri).",
      "node_id": "r_na_k_atpase"
    },
    {
      "q_tr": "Post-MI ventriküler aritmide tercih edilen sınıf IB ajan hangisidir?",
      "options_tr": [
        "Kinidin",
        "Lidokain",
        "Amiodaron (ilk tercih değil)",
        "Verapamil"
      ],
      "answer_idx": 1,
      "explanation_tr": "Lidokain iskemik/depolarize dokuda durum-bağımlı Na⁺ kanal bloğu yapar; akut VT/VF profilaksisinde kullanılmıştır.",
      "node_id": "r_nav15"
    },
    {
      "q_tr": "Torsades de pointes riski en çok hangi antiarrhythmik sınıfla ilişkilidir?",
      "options_tr": [
        "Sınıf II (β-bloker)",
        "Sınıf III (K⁺ kanal bloker)",
        "Sınıf IV (Ca²⁺ bloker)",
        "Adenozin"
      ],
      "answer_idx": 1,
      "explanation_tr": "IKr (hERG) bloğu repolarizasyonu uzatır → QT ↑ → torsades. Sotalol, dofetilid, amiodaron risk taşır.",
      "node_id": "e_qt_prolong"
    }
  ],
