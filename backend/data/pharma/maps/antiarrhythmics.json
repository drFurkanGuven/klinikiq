{
  "id": "antiarrhythmics",
  "title_tr": "Antiarrhythmikler — Vaughan Williams Sınıfları",
  "description_tr": "Sınıf I (Na⁺ kanal), II (β-bloker), III (K⁺ kanal), IV (Ca²⁺ kanal) ve digoksin/amiodaron gibi karma ajanların hedef iyon kanalları ve EKG etkileri (PR, QRS, QT).",
  "source_attribution": "Antiarrhythmik farmakolojisi StatPearls (Antiarrhythmic Medications, Amiodarone, Lidocaine) ve GtoPdb iyon kanalı ligand verileri (CC BY-SA 4.0) temel alınarak derlenmiştir.",
  "nodes": [
    {
      "id": "med_ach",
      "label_tr": "Asetilkolin (vagal)",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "Vagal uyarı SA/AV düğümde M2 reseptörü üzerinden K⁺ kanal açılımı → yavaşlatıcı etki. Digoksin vagal tonusu artırır."
    },
    {
      "id": "r_nav15",
      "label_tr": "Na⁺ kanalı (Nav1.5, hızlı)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Miyokard depolarizasyon fazı 0. Sınıf I ajanlar (lidokain, flekainid, prokainamid) durum-bağımlı bloke eder → QRS genişlemesi."
    },
    {
      "id": "r_herg",
      "label_tr": "K⁺ kanalı (hERG / IKr)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Repolarizasyon (faz 3). Sınıf III (amiodaron, sotalol) ve bazı ilaçlar IKr bloke eder → QT uzaması → torsades de pointes riski."
    },
    {
      "id": "r_cav12",
      "label_tr": "L-tip Ca²⁺ kanalı (Cav1.2)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "SA/AV düğümde yavaş inward Ca²⁺ akımı (faz 0). Sınıf IV (verapamil, diltiazem) ve dihidropiridinler hedefi."
    },
    {
      "id": "r_beta1",
      "label_tr": "β1 adrenerjik reseptör",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Sempatik uyarı → cAMP ↑ → SA/AV hızlanır, otomatisite artar. Sınıf II (β-bloker) burayı bloke eder."
    },
    {
      "id": "r_na_k_atpase",
      "label_tr": "Na⁺/K⁺-ATPaz (digoksin hedefi)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Digoksin inhibe eder → intraselüler Na⁺ ↑ → Na⁺/Ca²⁺ exchanger ile Ca²⁺ ↑ → pozitif inotropi; vagal tonus ↑ → AV ileti yavaşlar."
    },
    {
      "id": "o_sa_node",
      "label_tr": "SA düğüm",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Kardiyak pacemaker. β1 uyarı hızlandırır; Ca²⁺ kanal blokerleri ve β-bloker yavaşlatır."
    },
    {
      "id": "o_av_node",
      "label_tr": "AV düğüm",
      "type": "organ",
      "high_yield": true,
      "description_tr": "İleti gecikmesi (PR interval). Verapamil, diltiazem, digoksin ve β-bloker PR'yi uzatır."
    },
    {
      "id": "o_ventricle",
      "label_tr": "Ventrikül miyokard",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Na⁺ kanal aracılı hızlı depolarizasyon (QRS). Ventriküler aritmilerde sınıf IB (lidokain) etkili."
    },
    {
      "id": "o_repol",
      "label_tr": "Repolarizasyon (faz 3)",
      "type": "organ",
      "high_yield": true,
      "description_tr": "K⁺ kanal çıkış akımı action potential süresini belirler. Sınıf III AP süresini uzatır → QT ↑."
    },
    {
      "id": "e_hr_down",
      "label_tr": "Kalp hızı ↓",
      "type": "effect",
      "high_yield": true,
      "description_tr": "β-bloker, Ca²⁺ kanal blokeri (non-DHP), digoksin ile SA/AV yavaşlaması."
    },
    {
      "id": "e_pr_prolong",
      "label_tr": "PR interval ↑",
      "type": "effect",
      "high_yield": true,
      "description_tr": "AV nodal ileti gecikmesi. Verapamil, diltiazem, β-bloker, digoksin."
    },
    {
      "id": "e_qrs_wide",
      "label_tr": "QRS genişlemesi",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Sınıf I (özellikle IC flekainid) Na⁺ kanal bloğu → ventriküler depolarizasyon yavaşlar."
    },
    {
      "id": "e_qt_prolong",
      "label_tr": "QT uzaması",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Sınıf III (sotalol, amiodaron, dofetilid) IKr bloğu → torsades de pointes riski."
    },
    {
      "id": "e_inotropy_up",
      "label_tr": "İnotropi ↑ (digoksin)",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Digoksin miyokard Ca²⁺'yi artırır; hipokalemi toksisiteyi artırır."
    },
    {
      "id": "e_arrhythmia_suppress",
      "label_tr": "Aritmi baskılama",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Reentrant ve otomatik odakların baskılanması; sınıf ve aritmi tipine göre seçim kritik."
    }
  ],
