{
  "id": "gaba_benzodiazepine",
  "title_tr": "GABA-A Reseptörü & Benzodiazepinler",
  "description_tr": "GABA-A klorür kanal kompleksi, benzodiazepin bağlanma sitesi ve pozitif allosterik modülasyon. Anksiyoliz, sedasyon, antikonvülzan etki; flumazenil antagonizması ve tolerans/bağımlılık.",
  "source_attribution": "GABAergik farmakoloji StatPearls (Benzodiazepines, Flumazenil, Barbiturates) ve GtoPdb GABA-A receptor ligand verileri (CC BY-SA 4.0) temel alınarak derlenmiştir.",
  "nodes": [
    {
      "id": "med_gaba",
      "label_tr": "GABA (γ-aminobütirik asit)",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "Başlıca inhibitory nörotransmitter. GABA-A reseptöründe Cl⁻ kanalını açarak hiperpolarizasyon ve nöron baskılanması sağlar."
    },
    {
      "id": "med_glu",
      "label_tr": "Glutamat (zıt)",
      "type": "mediator",
      "high_yield": false,
      "description_tr": "Excitatory nörotransmitter. GABA/glutamat dengesi epilepsi ve anksiyete patofizyolojisinde merkezi."
    },
    {
      "id": "r_gaba_a",
      "label_tr": "GABA-A reseptörü (Cl⁻ kanalı)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Pentamerik ligand-gated iyon kanalı (α, β, γ alt birimleri). GABA bağlanınca Cl⁻ geçişi ↑ → inhibisyon."
    },
    {
      "id": "r_bdz_site",
      "label_tr": "Benzodiazepin bağlanma bölgesi",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "α-γ subunit arayüzünde allosterik site. Benzodiazepinler GABA'ya bağlı olmasa da frekansı artırarak Cl⁻ akımını potansiyalize eder (BZD)."
    },
    {
      "id": "r_barbiturate_site",
      "label_tr": "Barbitürat bağlanma bölgesi",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "GABA-A üzerinde ayrı site. Barbitüratlar (fenobarbital) kanal açık kalma süresini uzatır; GABA olmadan da aktivite (toksik dozda solunum depresyonu)."
    },
    {
      "id": "r_gaba_b",
      "label_tr": "GABA-B reseptörü",
      "type": "receptor",
      "high_yield": false,
      "description_tr": "G protein bağlı (Gi). Baclofen hedefi; spastisite tedavisinde."
    },
    {
      "id": "o_cns_cortex",
      "label_tr": "SSS — limbik/korteks",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Anksiyoliz ve sedasyonun ana hedefi. Benzodiazepinler anksiyete ve uyku bozukluklarında kullanılır."
    },
    {
      "id": "o_cns_reticular",
      "label_tr": "Retiküler aktivasyon sistemi",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Arousal ve uyanıklık. BZD sedasyon ve amnezi yapar."
    },
    {
      "id": "o_spinal",
      "label_tr": "Spinal kord / motor nöron",
      "type": "organ",
      "high_yield": true,
      "description_tr": "GABAergik inhibisyon. Baclofen (GABA-B) spastisitede; BZD kas gevşetici etki (zayıf)."
    },
    {
      "id": "o_brainstem_resp",
      "label_tr": "Beyin sapı (solunum)",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Yüksek doz BZD/barbitürat solunum depresyonu. Flumazenil BZD overdozunda spesifik antidot."
    },
    {
      "id": "e_anxiolysis",
      "label_tr": "Anksiyoliz",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Limbik sistemde GABAergic ton artışı → anksiyete azalması."
    },
    {
      "id": "e_sedation",
      "label_tr": "Sedasyon & hipnotik etki",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Doz bağımlı sedasyon. Kısa etkili (midazolam) vs uzun etkili (diazepam) seçim klinik."
    },
    {
      "id": "e_anticonvulsant",
      "label_tr": "Antikonvülzan etki",
      "type": "effect",
      "high_yield": true,
      "description_tr": "GABA ↑ → nöron excitability ↓. Status epileptikus'ta diazepam/midazolam IV."
    },
    {
      "id": "e_amnesia",
      "label_tr": "Anterograd amnezi",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Midazolam gibi ajanlar prosedürel sedasyon için kullanılır (amnezi istenen)."
    },
    {
      "id": "e_muscle_relax",
      "label_tr": "Kas gevşetici (zayıf)",
      "type": "effect",
      "high_yield": false,
      "description_tr": "Spinal interneuron inhibisyonu. Diazepam kas spazmında; ana endikasyon değil."
    },
    {
      "id": "e_dependence",
      "label_tr": "Tolerans & bağımlılık",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Kronik kullanımda reseptör downregülasyonu → tolerans. Ani kesilince rebound anksiyete, insomnia, withdrawal (deliryum tremens benzeri)."
    },
    {
      "id": "e_resp_depression",
      "label_tr": "Solunum depresyonu",
      "type": "effect",
      "high_yield": true,
      "description_tr": "BZD + opioid/alcohol sinerjisi → fatal solunum depresyonu. Flumazenil antidot."
    }
  ],
