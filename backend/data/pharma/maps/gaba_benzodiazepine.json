  "quiz": [
    {
      "q_tr": "Benzodiazepinler GABA-A reseptöründe nasıl etki eder?",
      "options_tr": [
        "Doğrudan Cl⁻ kanalını açarlar",
        "Pozitif allosterik modülasyon (GABA frekansını artırır)",
        "GABA yıkımını inhibe eder",
        "Glutamat reseptörünü bloke eder"
      ],
      "answer_idx": 1,
      "explanation_tr": "BZD allosterik siteye bağlanır; endojen GABA'nın Cl⁻ kanalını açma frekansını artırır. GABA olmadan minimal etki.",
      "node_id": "r_bdz_site"
    },
    {
      "q_tr": "Barbitüratlar benzodiazepinlerden farklı olarak ne yapabilir?",
      "options_tr": [
        "Sadece GABA varken etkilidirler",
        "GABA olmadan da kanalı aktive edebilir (yüksek doz)",
        "Flumazenil ile antagonize edilir",
        "Anksiyoliz yapmazlar"
      ],
      "answer_idx": 1,
      "explanation_tr": "Barbitüratlar kanal açık kalma süresini uzatır; yüksek dozda GABA'dan bağımsız aktivasyon → ciddi solunum depresyonu.",
      "node_id": "r_barbiturate_site"
    },
    {
      "q_tr": "Status epileptikus acil tedavisinde IV tercih edilen benzodiazepin hangisidir?",
      "options_tr": [
        "Diazepam veya lorazepam",
        "Flumazenil",
        "Baklofen",
        "Zolpidem"
      ],
      "answer_idx": 0,
      "explanation_tr": "Lorazepam/diazepam hızlı GABAergic ton artışı ile nöbeti sonlandırır. Flumazenil antagonisttir.",
      "node_id": "e_anticonvulsant"
    },
    {
      "q_tr": "Flumazenil kullanımında en önemli risk nedir?",
      "options_tr": [
        "Kalıcı sedasyon",
        "Kronik BZD kullanıcısında withdrawal/nöbet",
        "Hipertansiyon",
        "Bronkospazm"
      ],
      "answer_idx": 1,
      "explanation_tr": "Flumazenil BZD antagonistidir; kronik kullanıcıda ani withdrawal ve convulsiyon tetikleyebilir. Kısa yarı ömür → re-sedasyon.",
      "node_id": "r_bdz_site"
    },
    {
      "q_tr": "BZD + opioid kombinasyonu neden tehlikelidir?",
      "options_tr": [
        "Hipertansiyon",
        "Sinerjistik solunum depresyonu",
        "Hiperkalemi",
        "Trombositopeni"
      ],
      "answer_idx": 1,
      "explanation_tr": "Her ikisi de solunum merkezini baskılar; kombine kullanım fatal solunum depresyonu riskini belirgin artırır (FDA black box).",
      "node_id": "e_resp_depression"
    },
    {
      "q_tr": "Baklofen hangi reseptörü hedefler?",
      "options_tr": [
        "GABA-A",
        "GABA-B",
        "NMDA",
        "Glycin"
      ],
      "answer_idx": 1,
      "explanation_tr": "Baklofen GABA-B (Gi) agonistidir; spinal düzeyde spastisite tedavisinde kullanılır.",
      "node_id": "r_gaba_b"
    }
  ],
