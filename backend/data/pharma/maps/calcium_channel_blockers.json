  "source_attribution": "Kalsiyum kanal bloker farmakolojisi StatPearls (Calcium Channel Blockers, Amlodipine, Verapamil) ve GtoPdb Cav1.x verileri (CC BY-SA 4.0) temel alınarak derlenmiştir.",
  "nodes": [
    { "id": "med_ca_influx", "label_tr": "Ca²⁺ influx", "type": "mediator", "high_yield": true, "description_tr": "L-tip voltage-gated Ca²⁺ kanallarından hücre içi Ca²⁺ girişi. Düz kas kasılması ve kardiyak pacemaker/iletim için gerekli." },

    { "id": "r_cav_l_vascular", "label_tr": "L-tip Ca²⁺ kanalı (vasküler)", "type": "receptor", "high_yield": true, "description_tr": "Damar düz kasında depolarizasyon → Ca²⁺ girişi → kasılma. DHP'ler (amlodipin, nifedipin) vasküler selektiftir." },
    { "id": "r_cav_l_cardiac", "label_tr": "L-tip Ca²⁺ kanalı (kardiyak)", "type": "receptor", "high_yield": true, "description_tr": "SA/AV düğüm (yavaş depolarizasyon) ve miyokard kontraktilitesi. Verapamil/diltiazem kardiyak ve vasküler etki; DHP daha vasküler selektif." },

    { "id": "o_vascular_smooth", "label_tr": "Vasküler düz kas", "type": "organ", "high_yield": true, "description_tr": "Ca²⁺-kalmodulin → MLCK aktivasyonu → kasılma. CCB Ca²⁺ girişini ↓ → vazodilatasyon." },
    { "id": "o_sa_av", "label_tr": "SA & AV düğüm", "type": "organ", "high_yield": true, "description_tr": "Ca²⁺ inward akım faz 0 (nodal dokuda). Non-DHP CCB bradikardi ve AV blok yapar." },
    { "id": "o_myocardium", "label_tr": "Miyokard", "type": "organ", "high_yield": true, "description_tr": "Ca²⁺ girişi kontraktilite için. Verapamil inotropiyi baskılar (dHP'den daha belirgin)." },
    { "id": "o_coronary", "label_tr": "Koroner arter", "type": "organ", "high_yield": true, "description_tr": "Vazodilatasyon → koroner perfüzyon ↑. Antianginal etkinin temel bileşeni." },

    { "id": "e_vasodilation", "label_tr": "Vazodilatasyon & KB ↓", "type": "effect", "high_yield": true, "description_tr": "Periferik direnç ↓ → antihipertansif. Refleks taşikardi DHP'lerde (nifedipin) görülebilir." },
    { "id": "e_antianginal", "label_tr": "Antianginal etki", "type": "effect", "high_yield": true, "description_tr": "Preload/afterload ↓ + koroner vazodilatasyon → O2 tüketimi ↓." },
    { "id": "e_bradycardia", "label_tr": "Bradikardi & AV blok", "type": "effect", "high_yield": true, "description_tr": "Non-DHP (verapamil, diltiazem) SA/AV baskılanması. β-bloker ile kombinede dikkat." },
    { "id": "e_reflex_tach", "label_tr": "Refleks taşikardi", "type": "effect", "high_yield": true, "description_tr": "DHP vazodilatasyonu → baroreseptor refleks taşikardi. Nifedipin kısa etkili formlarda belirgin." },
    { "id": "e_edema", "label_tr": "Periferik ödem", "type": "effect", "high_yield": true, "description_tr": "DHP'lerde precapiller vazodilatasyon → hidrostatik ödem (doz bağımlı, diüretikle tam çözülmez)." },
    { "id": "e_constipation", "label_tr": "Konstipasyon (verapamil)", "type": "effect", "high_yield": true, "description_tr": "Verapamil GI düz kas Ca²⁺ bloğu → konstipasyon sık yan etki." }
