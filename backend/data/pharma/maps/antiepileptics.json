{
  "id": "antiepileptics",
  "title_tr": "Antiepileptik İlaçlar — Mekanizma Haritası",
  "description_tr": "Na⁺ kanal stabilizasyonu, GABA artışı, Ca²⁺ kanal blokajı ve sinaptik vezikül proteini (SV2A) hedefleri. Fenitoin, karbamazepin, valproat, lamotrijin, levetirasetam profilleri.",
  "source_attribution": "Antiepileptik farmakoloji StatPearls (Antiepileptic Drugs, Phenytoin, Valproic Acid, Carbamazepine) ve GtoPdb (CC BY-SA 4.0) temel alınarak derlenmiştir.",
  "nodes": [
    {
      "id": "med_glu",
      "label_tr": "Glutamat",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "Excitatory nörotransmitter. NMDA/AMPA reseptörleri üzerinden depolarizasyon ve nöbet yayılımı."
    },
    {
      "id": "med_gaba",
      "label_tr": "GABA",
      "type": "mediator",
      "high_yield": true,
      "description_tr": "İnhibitory nörotransmitter. GABA-A aktivasyonu nöbet eşiğini yükseltir."
    },
    {
      "id": "r_nav",
      "label_tr": "Voltage-gated Na⁺ kanalı",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Aksiyon potansiyeli faz 0. Fenitoin, karbamazepin, lamotrijin durum-bağımlı inaktif kanal stabilizasyonu → yüksek frekanslı deşarj baskılanır."
    },
    {
      "id": "r_cav",
      "label_tr": "T-tip / N-tip Ca²⁺ kanalı",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "T-tipe thalamik osilasyon (absans); N-tipe presinaptik Ca²⁺ → nörotransmitter salınımı. Etosüksimid T-tip; gabapentinoidler α2δ subunit."
    },
    {
      "id": "r_gaba_a",
      "label_tr": "GABA-A reseptörü",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Valproat GABA sentezini artırır/GABA-T inhibisyonu; barbitürat/benzodiazepin allosterik modülasyon."
    },
    {
      "id": "r_gaba_transaminase",
      "label_tr": "GABA-transaminaz (GABA-T)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "GABA katabolizması. Valproat ve vigabatrin inhibe eder → GABA ↑."
    },
    {
      "id": "r_sv2a",
      "label_tr": "SV2A (sinaptik vezikül proteini)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Levetirasetam bağlanma hedefi. Presinaptik nörotransmitter salınım modülasyonu (mekanizma tam çözülmemiş)."
    },
    {
      "id": "r_alpha2delta",
      "label_tr": "α2δ subunit (Ca²⁺ kanal)",
      "type": "receptor",
      "high_yield": true,
      "description_tr": "Gabapentin ve pregabalin hedefi. Presinaptik Ca²⁺ kanal trafiği ↓ → excitatory salınım ↓."
    },
    {
      "id": "o_cortex",
      "label_tr": "Serebral korteks",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Fokal ve ikincil jeneralize nöbetlerin başlangıç odağı. Na⁺ kanal blokerleri etkili."
    },
    {
      "id": "o_hippocampus",
      "label_tr": "Hipokampus (temporal lob)",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Temporal lob epilepsisi. Karbamazepin, lamotrijin, levetirasetam."
    },
    {
      "id": "o_thalamus",
      "label_tr": "Talamus (T-tip Ca²⁺)",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Absans nöbetlerde talamokortikal osilasyon. Etosüksimid T-tip Ca²⁺ kanal bloker."
    },
    {
      "id": "o_synapse",
      "label_tr": "Presinaptik terminal",
      "type": "organ",
      "high_yield": true,
      "description_tr": "Nörotransmitter salınımı. Levetirasetam (SV2A), gabapentin (α2δ) burada etkili."
    },
    {
      "id": "e_seizure_suppress",
      "label_tr": "Nöbet baskılama",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Excitability ↓ veya inhibisyon ↑ ile nöbet eşiği yükselir."
    },
    {
      "id": "e_focal",
      "label_tr": "Fokal nöbet kontrolü",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Na⁺ kanal blokerleri (fenitoin, karbamazepin, lamotrijin) fokal başlangıçlı nöbetlerde etkili."
    },
    {
      "id": "e_absence",
      "label_tr": "Absans nöbet kontrolü",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Etosüksimid/valproat absans için; karbamazepin absansı kötüleştirebilir (TUS klasiği)."
    },
    {
      "id": "e_sedation",
      "label_tr": "Sedasyon / SSS yan etki",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Barbitürat, benzodiazepin, topiramat, valproat ile görülür."
    },
    {
      "id": "e_teratogenic",
      "label_tr": "Teratojenite (valproat)",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Valproat nöral tüp defekti ve kognitif risk → gebelikte kontrendike (alternatif tercih)."
    },
    {
      "id": "e_stevens_johnson",
      "label_tr": "Cilt reaksiyonu (SJS/TEN)",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Lamotrijin, karbamazepin HLA-B*1502 (Asya) ile SJS riski. Yavaş titrasyon lamotrijinde."
    },
    {
      "id": "e_gingival",
      "label_tr": "Diş eti hipertrofisi (fenitoin)",
      "type": "effect",
      "high_yield": true,
      "description_tr": "Fenitoin karakteristik yan etki; terapötik ilaç izlemi (serum düzeyi) gerekir."
    }
  ],
