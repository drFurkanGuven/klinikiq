  "quiz": [
    {
      "q_tr": "Absans nöbet tedavisinde birinci tercih hangisidir?",
      "options_tr": [
        "Karbamazepin",
        "Etosüksimid",
        "Fenitoin",
        "Gabapentin"
      ],
      "answer_idx": 1,
      "explanation_tr": "Etosüksimid T-tip Ca²⁺ kanal bloker; talamokortikal absans osilasyonunu baskılar. Karbamazepin absansı kötüleştirebilir.",
      "node_id": "e_absence"
    },
    {
      "q_tr": "Karbamazepin absans nöbetlerde neden kontrendikedir?",
      "options_tr": [
        "GABA çok artırır",
        "T-tip Ca²⁺ kanallarını uyararak absansı artırabilir",
        "Sadece renal atılım bozuk",
        "SV2A bloke eder"
      ],
      "answer_idx": 1,
      "explanation_tr": "Na⁺ kanal blokerleri absans (T-tip Ca²⁺ aracılı) nöbetleri kötüleştirebilir. Absans için etosüksimid/valproat tercih edilir.",
      "node_id": "o_thalamus"
    },
    {
      "q_tr": "Valproatın epilepsi dışı en ciddi advers etkisi (gebelik) nedir?",
      "options_tr": [
        "Diş eti hipertrofisi",
        "Nöral tüp defekti / teratojenite",
        "Aplastik anemi",
        "Steven-Johnson"
      ],
      "answer_idx": 1,
      "explanation_tr": "Valproat gebelikte nöral tüp defekti ve nörogelişimsel bozukluk riski taşır → gebe/epileptik kadında alternatif tercih.",
      "node_id": "e_teratogenic"
    },
    {
      "q_tr": "Levetirasetamın bilinen hedefi nedir?",
      "options_tr": [
